# Copy to examples/.env. Run the commands in examples/README.md from the repo root.
DISCORD_TOKEN=replace_with_your_bot_token

# Optional: register commands in one test server. Blank means global commands.
DEV_GUILD_ID=

# Two shards on one host. Generate a secret with the command in the README.
SHARD_COUNT=2
SHARD_HOST_ID=local
SHARD_HOST_TOKEN=replace_with_a_generated_secret
SHARD_COORDINATOR_URL=ws://127.0.0.1:8080/sharding

# Coordinator settings. Keep the SQLite file between restarts.
SHARD_COORDINATOR_HOST=127.0.0.1
SHARD_COORDINATOR_PORT=8080
SHARD_STATE_PATH=./sharding.sqlite

# Optional: JSON host assignments for more than one machine (see README).
SHARD_WORKERS=

# Required together when listening outside localhost; paths to PEM files.
SHARD_TLS_CERT=
SHARD_TLS_KEY=
